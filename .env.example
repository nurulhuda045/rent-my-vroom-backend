# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# JWT
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Application
PORT=4000
# Comma-separated list of allowed CORS origins. Only enforced when NODE_ENV=production.
FRONTEND_URLS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Cloudflare R2
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<public-bucket-domain>.r2.dev

# Email — Brevo transactional API (https://www.brevo.com/)
BREVO_API_KEY=
EMAIL_FROM=noreply@example.com
# Optional display name for the From header
EMAIL_FROM_NAME=RentMyVroom

# WhatsApp Business Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v21.0
# Required for Meta webhook verification (GET /whatsapp/webhook)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_secure_token

# Optional: Meta-approved template names for transactional WhatsApp (leave unset to skip WA for that event).
# Parameter order must match your Meta template bodies — see src/messaging/messaging.service.ts
# WHATSAPP_TMPL_LICENSE_APPROVED=
# WHATSAPP_TMPL_LICENSE_REJECTED=
# WHATSAPP_TMPL_KYC_APPROVED=
# WHATSAPP_TMPL_KYC_REJECTED=
# WHATSAPP_TMPL_BOOKING_NEW_MERCHANT=
# WHATSAPP_TMPL_BOOKING_ACCEPTED_RENTER=
# WHATSAPP_TMPL_BOOKING_REJECTED_RENTER=
# WHATSAPP_TMPL_BOOKING_COMPLETED_RENTER=
# WHATSAPP_TMPL_BOOKING_CANCELLED_MERCHANT=
# WHATSAPP_TMPL_BOOKING_AUTO_CANCEL_RENTER=
# WHATSAPP_TMPL_BOOKING_AUTO_CANCEL_MERCHANT=

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30

# Test OTP
TEST_OTP=123456
